# Production — valores armazenados como EAS Secrets (nunca commitar com valores reais)
# eas secret:create --scope project --name EXPO_PUBLIC_REVENUECAT_IOS_API_KEY --value "appl_..."
APP_ENV=production
EXPO_PUBLIC_API_BASE_URL=https://bethunter-api-production.up.railway.app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_REAL_VALUE
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_REAL_VALUE
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_REAL_VALUE
# RevenueCat produção: iOS = appl_... | Android = goog_...
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_DEFAULT_OFFERING_IDENTIFIER=default
