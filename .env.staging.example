# Staging — copiar para .env.staging para builds locais de staging
# Para EAS Cloud: eas secret:push --scope project --env-file .env.staging
APP_ENV=staging
EXPO_PUBLIC_API_BASE_URL=https://staging-api.bethunter.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# RevenueCat staging: usar chaves com prefixo test_ (ambiente sandbox)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_REPLACE_ME
EXPO_PUBLIC_REVENUECAT_DEFAULT_OFFERING_IDENTIFIER=default
