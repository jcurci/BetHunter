# Frontend — copiar para .env para dev local com expo start
# Para builds EAS staging/prod: usar `eas secret:push` ou configurar no eas.json

# URL do backend (Android emulator usa 10.0.2.2, iOS simulator usa 127.0.0.1)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Google OAuth — mesmos IDs para todos os ambientes
# (vinculados ao package name + SHA-1; configurar no Google Cloud Console)
# O URL scheme iOS (REVERSED_CLIENT_ID) é derivado automaticamente do EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# RevenueCat SDK keys (PUBLIC — seguro embutir no APK, por design do RevenueCat)
# Dev/Staging: prefixo test_ (sandbox) | Prod iOS: appl_... | Prod Android: goog_...
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_DEFAULT_OFFERING_IDENTIFIER=default
